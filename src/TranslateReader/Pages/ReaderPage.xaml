<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:TranslateReader.PageModels"
             xmlns:controls="clr-namespace:TranslateReader.Pages.Controls"
             xmlns:models="clr-namespace:TranslateReader.Models;assembly=TranslateReader.Core"
             xmlns:local="clr-namespace:TranslateReader.Pages"
             x:Class="TranslateReader.Pages.ReaderPage"
             x:DataType="pm:ReaderPageModel"
             Title="{Binding Book.Title}">

    <ContentPage.Resources>
        <local:OneBasedIndexConverter x:Key="OneBasedIndexConverter" />
    </ContentPage.Resources>

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="True" />
    </Shell.BackButtonBehavior>

    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" HorizontalOptions="Fill">
            <Button Grid.Column="0"
                    x:Name="TocButton"
                    Text="&#xE2F0;"
                    FontFamily="Phosphor"
                    FontSize="18"
                    BackgroundColor="Transparent"
                    Clicked="OnTocButtonClicked"
                    Padding="0"
                    WidthRequest="36"
                    HeightRequest="36"
                    MinimumWidthRequest="36"
                    MinimumHeightRequest="36"
                    IsVisible="{OnIdiom Default=False, Desktop=True}" />
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="1"
                                 VerticalOptions="Center">
                <Label Text="{Binding Book.Title}"
                       FontFamily="InterRegular"
                       FontSize="14"
                       MaxLines="1"
                       LineBreakMode="TailTruncation" />
                <Label x:Name="ChapterSubtitleLabel"
                       Text="{Binding ChapterSubtitle}"
                       FontSize="11"
                       TextColor="{StaticResource Neutral600}"
                       MaxLines="1"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    Text="Aa"
                    FontFamily="InterMedium"
                    FontSize="15"
                    BackgroundColor="Transparent"
                    Clicked="OnTranslateButtonClicked"
                    Padding="0"
                    WidthRequest="36"
                    HeightRequest="36"
                    MinimumWidthRequest="36"
                    MinimumHeightRequest="36" />
            <Button Grid.Column="3"
                    Text="&#xE272;"
                    FontFamily="Phosphor"
                    FontSize="18"
                    BackgroundColor="Transparent"
                    Clicked="OnSettingsButtonClicked"
                    Padding="0"
                    WidthRequest="36"
                    HeightRequest="36"
                    MinimumWidthRequest="36"
                    MinimumHeightRequest="36" />
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <ActivityIndicator Grid.RowSpan="4"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <BoxView Grid.Row="0"
                 x:Name="TranslationModeIndicator"
                 HeightRequest="5"
                 Color="{StaticResource ColorAccent}"
                 IsVisible="{Binding IsTranslationModeActive}" />

        <ProgressBar Grid.Row="1"
                     Progress="{Binding TranslationProgress}"
                     IsVisible="{Binding IsTranslating}"
                     ProgressColor="{StaticResource ColorAccent}"
                     HeightRequest="4" />

        <HybridWebView Grid.Row="2" 
                       x:Name="ContentWebView"
                       
                       DefaultFile="index.html"
                       RawMessageReceived="OnHybridMessageReceived" />

        <!-- Footer: only shown in Paginated mode (PIXEL-SPEC "Reader - footer"). -->
        <Border Grid.Row="3"
                x:Name="ReaderFooter"
                BackgroundColor="{StaticResource ColorBg}"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="20,10"
                HeightRequest="54">
            <Border.StrokeShape>
                <Rectangle />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <BoxView Grid.ColumnSpan="3"
                         VerticalOptions="Start"
                         HeightRequest="1"
                         Color="{StaticResource ColorDivider}" />

                <Button Grid.Column="0"
                        x:Name="PreviousButton"
                        Text="Anterior"
                        FontFamily="InterMedium"
                        FontSize="14"
                        TextColor="{StaticResource ColorText}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource ColorDivider}"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="34"
                        MinimumHeightRequest="34"
                        Padding="10,6"
                        ContentLayout="Left,6"
                        Clicked="OnPreviousButtonClicked"
                        IsVisible="False">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Phosphor" Glyph="&#xE138;" Size="14" Color="{StaticResource ColorText}" />
                    </Button.ImageSource>
                </Button>

                <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label x:Name="PageIndicatorLabel"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="12"
                           TextColor="{StaticResource Neutral500}"
                           IsVisible="False" />
                    <ProgressBar x:Name="PageProgressBar"
                                 WidthRequest="200"
                                 HeightRequest="2"
                                 ProgressColor="{StaticResource ColorAccent}"
                                 BackgroundColor="{StaticResource Neutral900}"
                                 IsVisible="False" />
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        x:Name="NextButton"
                        Text="Próximo"
                        FontFamily="InterMedium"
                        FontSize="14"
                        TextColor="{StaticResource ColorText}"
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource ColorDivider}"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="34"
                        MinimumHeightRequest="34"
                        Padding="10,6"
                        ContentLayout="Right,6"
                        Clicked="OnNextButtonClicked"
                        IsVisible="False">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="Phosphor" Glyph="&#xE13A;" Size="14" Color="{StaticResource ColorText}" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- Painel de capitulos (TOC): drawer fixo de ~250px que desliza a partir da borda
             esquerda sobre o conteudo (D-...-4). Diferente do SettingsOverlay, nao ha backdrop
             escurecido nem bloqueio de input no resto da tela - e um painel opaco ancorado,
             nao um overlay modal flutuante. Visivel so no Desktop (gatilho = TocButton). -->
        <Border Grid.RowSpan="4"
                x:Name="ChaptersPanel"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                WidthRequest="250"
                BackgroundColor="{StaticResource ColorBg}"
                Stroke="Transparent"
                StrokeThickness="0"
                StrokeShape="Rectangle"
                Padding="0"
                IsVisible="False"
                Opacity="0">
            <!-- Border.Stroke cannot express a single-side hairline (StrokeThickness is a
                 double in MAUI, not a Thickness - "0,0,1,0" parsed as 10 via NumberStyles.Any,
                 see D-...-10). Real hairline lives in the sibling BoxView below. -->
            <Grid>
                <ScrollView>
                    <VerticalStackLayout Spacing="2" Padding="12,18">
                    <Label Text="Capítulos"
                           FontSize="13"
                           FontFamily="InterMedium"
                           TextTransform="Uppercase"
                           CharacterSpacing="1"
                           TextColor="{StaticResource Neutral600}"
                           Margin="10,0,0,8" />
                    <CollectionView x:Name="ChaptersCollection"
                                    ItemsSource="{Binding Chapters}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnChapterSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Chapter">
                                <!-- Item ativo: bg AccentTint10 via VisualState (Border-level property).
                                     O titulo permanece ColorText no estado ativo - MAUI VisualState
                                     Setters so alcancam propriedades do proprio elemento (sem
                                     TargetName tipo WPF), entao recolorir o Label filho exigiria
                                     code-behind; ColorText fica como fallback consciente aqui. -->
                                <Border Margin="0,1"
                                        Padding="10,8"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        StrokeShape="RoundRectangle 8">
                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               Text="{Binding OrderIndex, Converter={StaticResource OneBasedIndexConverter}}"
                                               FontSize="11"
                                               TextColor="{StaticResource Neutral600}"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               TextColor="{StaticResource ColorText}"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                    </Grid>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource AccentTint10}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>
                <BoxView WidthRequest="1"
                         HorizontalOptions="End"
                         BackgroundColor="{StaticResource ColorDivider}" />
            </Grid>
        </Border>

        <!-- Overlay de download do modelo -->
        <Grid Grid.RowSpan="4"
              IsVisible="{Binding IsModelDownloading}"
              InputTransparent="False">
            <BoxView Color="Black" Opacity="0.4" />
            <Border VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource ColorSurface}"
                    Stroke="{StaticResource Neutral800}"
                    StrokeThickness="1"
                    Shadow="{StaticResource ShadowMd}"
                    StrokeShape="RoundRectangle 16"
                    Padding="24"
                    WidthRequest="320">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Baixando modelo de traducao..."
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <ProgressBar Progress="{Binding ModelDownloadProgress}"
                                 ProgressColor="{StaticResource ColorAccent}" />
                    <Label Text="{Binding ModelDownloadProgress, StringFormat='{0:P0}'}"
                           HorizontalOptions="Center"
                           FontSize="14" />
                    <Label Text="Tamanho aproximado: ~1.6 GB"
                           HorizontalOptions="Center"
                           FontSize="12"
                           TextColor="{StaticResource Neutral500}" />
                    <Button Text="Cancelar"
                            Clicked="OnCancelDownloadClicked"
                            BackgroundColor="{StaticResource ColorDanger}"
                            TextColor="White"
                            CornerRadius="8"
                            HorizontalOptions="Center"
                            MinimumHeightRequest="44"
                            Padding="20,8" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Overlay de carregamento do modelo -->
        <Grid Grid.RowSpan="4"
              IsVisible="{Binding IsModelLoading}"
              InputTransparent="False">
            <BoxView Color="Black" Opacity="0.4" />
            <Border VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource ColorSurface}"
                    Stroke="{StaticResource Neutral800}"
                    StrokeThickness="1"
                    Shadow="{StaticResource ShadowMd}"
                    StrokeShape="RoundRectangle 16"
                    Padding="24"
                    WidthRequest="320">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Carregando modelo..."
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource ColorAccent}"
                                       HorizontalOptions="Center" />
                    <Label Text="Preparando o modelo para traducao"
                           HorizontalOptions="Center"
                           FontSize="12"
                           TextColor="{StaticResource Neutral500}" />
                    <Button Text="Cancelar"
                            Clicked="OnCancelDownloadClicked"
                            BackgroundColor="{StaticResource ColorDanger}"
                            TextColor="White"
                            CornerRadius="8"
                            HorizontalOptions="Center"
                            MinimumHeightRequest="44"
                            Padding="20,8" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <controls:SettingsOverlay Grid.RowSpan="4"
                                  x:Name="SettingsOverlay"
                                  IsVisible="False"
                                  InputTransparent="True" />
    </Grid>
</ContentPage>
