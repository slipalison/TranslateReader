<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:TranslateReader.PageModels"
             xmlns:models="clr-namespace:TranslateReader.Models;assembly=TranslateReader.Core"
             x:Class="TranslateReader.Pages.LibraryPage"
             x:DataType="pm:LibraryPageModel"
             BackgroundColor="{StaticResource ColorBg}"
             Title="Biblioteca">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Importar"
                     Command="{Binding ImportBookCommand}" />
    </ContentPage.ToolbarItems>

    <Grid ColumnDefinitions="Auto,*">

        <!-- Sidebar: Desktop only (D-...-5). On mobile it collapses (IsVisible=False,
             WidthRequest=0) and the top bar in the main content column becomes the
             compact header at the top, as in mobile-library.jpg. -->
        <Border x:Name="SidebarPanel"
                Grid.Column="0"
                IsVisible="{OnIdiom Default=False, Desktop=True}"
                WidthRequest="{OnIdiom Default=0, Desktop=240}"
                BackgroundColor="{StaticResource ColorSurface}"
                Stroke="{StaticResource Neutral800}"
                StrokeThickness="0,0,1,0"
                StrokeShape="Rectangle"
                Padding="20,24">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="28">

                <HorizontalStackLayout Grid.Row="0" Spacing="10">
                    <Label Text="&#128218;"
                           FontSize="20"
                           VerticalOptions="Center" />
                    <Label Text="TranslateReader"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource ColorText}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="4">
                    <Border BackgroundColor="Transparent"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowLibraryBooksCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsRecentFilterActive}"
                                         Value="False">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent900}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Biblioteca"
                               FontSize="14"
                               TextColor="{StaticResource ColorText}" />
                    </Border>

                    <Border x:Name="RecentFilterButton"
                            BackgroundColor="Transparent"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowRecentBooksCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding IsRecentFilterActive}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent900}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="Recentes"
                               FontSize="14"
                               TextColor="{StaticResource ColorText}" />
                    </Border>
                </VerticalStackLayout>

                <BoxView Grid.Row="2"
                         BackgroundColor="Transparent"
                         InputTransparent="True" />

                <Border x:Name="ModelStatusCard"
                        Grid.Row="3"
                        BackgroundColor="{StaticResource ColorBg}"
                        Stroke="{StaticResource Neutral800}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Modelo de tradução"
                               FontSize="11"
                               TextColor="{StaticResource Neutral500}" />
                        <Label FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ColorText}"
                               LineBreakMode="TailTruncation">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ModelStatus.Name}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding ModelSizeDisplay}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding ModelStatusText}"
                               FontSize="11"
                               TextColor="{StaticResource Neutral500}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*"
              Padding="24,20"
              RowSpacing="16">

            <!-- Top bar: title + count, search, target-language chip. This is also the
                 mobile compact header once SidebarPanel collapses to width 0. -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="0">
                    <Label Text="Biblioteca"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource ColorText}" />
                    <Label x:Name="BookCountLabel"
                           Text="{Binding Books.Count, StringFormat='{0} livros'}"
                           FontSize="12"
                           TextColor="{StaticResource Neutral500}" />
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource ColorSurface}"
                        Stroke="{StaticResource Neutral800}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,0"
                        WidthRequest="{OnIdiom Default=200, Desktop=280}"
                        VerticalOptions="Center">
                    <Entry x:Name="SearchEntry"
                           Text="{Binding SearchQuery}"
                           Placeholder="Buscar título ou autor..."
                           TextColor="{StaticResource ColorText}"
                           PlaceholderColor="{StaticResource Neutral500}"
                           BackgroundColor="Transparent"
                           FontSize="13" />
                </Border>

                <Border x:Name="TargetLanguageChip"
                        Grid.Column="2"
                        BackgroundColor="{StaticResource ColorSurface}"
                        Stroke="{StaticResource Neutral800}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="12,6"
                        VerticalOptions="Center">
                    <Label Text="{Binding TargetLanguage}"
                           FontSize="12"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           TextColor="{StaticResource ColorText}" />
                </Border>
            </Grid>

            <!-- Hero: continue reading (most recent book with progress) -->
            <Border x:Name="ContinueReadingHero"
                    Grid.Row="1"
                    IsVisible="{Binding HasContinueReadingBook}"
                    BackgroundColor="{StaticResource ColorSurface}"
                    Stroke="{StaticResource Neutral800}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Grid.Column="0"
                            WidthRequest="52"
                            HeightRequest="76"
                            Padding="0"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource ColorSection}" Offset="0.0" />
                                <GradientStop Color="{StaticResource ColorSectionGlow}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image Source="{Binding ContinueReadingBook.CoverImagePath, Converter={StaticResource FilePathToImageSourceConverter}}"
                               Aspect="AspectFill"
                               IsVisible="{Binding ContinueReadingBook.CoverImagePath, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="CONTINUE LENDO"
                               FontSize="11"
                               CharacterSpacing="1"
                               TextColor="{StaticResource ColorAccent}" />
                        <Label Text="{Binding ContinueReadingBook.Title}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ColorText}" />
                        <Label FontSize="12" TextColor="{StaticResource Neutral400}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding ContinueReadingBook.Author}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding ContinueReadingBook.ProgressPercentage, StringFormat='{0:0}%'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <ProgressBar Progress="{Binding ContinueReadingBook.ProgressPercentage, Converter={StaticResource PercentageToDecimalConverter}}"
                                     ProgressColor="{StaticResource ColorAccent}"
                                     BackgroundColor="{StaticResource Neutral800}" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2"
                            VerticalOptions="Center"
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource Accent700}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="16,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenBookCommand}"
                                                   CommandParameter="{Binding ContinueReadingBook}" />
                        </Border.GestureRecognizers>
                        <Label Text="Continuar &#8594;"
                               FontSize="13"
                               TextColor="{StaticResource ColorAccent}" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   Color="{StaticResource ColorAccent}"
                                   ZIndex="1" />

                <CollectionView x:Name="BooksCollection"
                                ItemsSource="{Binding Books}"
                                EmptyView="Nenhum livro importado. Toque em Importar para adicionar um EPUB.">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="3"
                                         HorizontalItemSpacing="14"
                                         VerticalItemSpacing="18" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:BookSummary">
                            <Grid Padding="2"
                                  MaximumWidthRequest="170"
                                  HorizontalOptions="Center">
                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Traduzir livro"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:LibraryPageModel}}, Path=TranslateBookCommand}"
                                                        CommandParameter="{Binding}" />
                                        <MenuFlyoutItem Text="Excluir"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:LibraryPageModel}}, Path=DeleteBookCommand}"
                                                        CommandParameter="{Binding}" />
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type pm:LibraryPageModel}}, Path=OpenBookCommand}"
                                        CommandParameter="{Binding}" />
                                </Grid.GestureRecognizers>

                                <Grid RowDefinitions="Auto,Auto,Auto">

                                    <!-- Capa 2:3, cantos arredondados, gradiente placeholder ou imagem real -->
                                    <Border Grid.Row="0"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="{StaticResource Neutral800}"
                                            StrokeThickness="1"
                                            Shadow="{StaticResource ShadowMd}"
                                            Padding="0"
                                            HeightRequest="210">
                                        <Grid>
                                            <Grid IsVisible="{Binding CoverImagePath, Converter={StaticResource StringIsNullOrEmptyConverter}}">
                                                <Grid.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{StaticResource ColorSection}" Offset="0.0" />
                                                        <GradientStop Color="{StaticResource ColorSectionGlow}" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Grid.Background>
                                                <Label Text="EPUB"
                                                       VerticalOptions="End"
                                                       HorizontalOptions="Start"
                                                       Margin="8,0,0,8"
                                                       FontSize="9"
                                                       CharacterSpacing="1"
                                                       TextColor="{StaticResource Neutral300}" />
                                            </Grid>

                                            <Image Source="{Binding CoverImagePath, Converter={StaticResource FilePathToImageSourceConverter}}"
                                                   Aspect="AspectFill"
                                                   IsVisible="{Binding CoverImagePath, Converter={StaticResource StringIsNotNullOrEmptyConverter}}" />

                                            <ProgressBar VerticalOptions="End"
                                                         HeightRequest="4"
                                                         Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageToDecimalConverter}}"
                                                         ProgressColor="{StaticResource ColorAccent}"
                                                         BackgroundColor="Transparent" />
                                        </Grid>
                                    </Border>

                                    <!-- Título -->
                                    <Label Grid.Row="1"
                                           Text="{Binding Title}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource ColorText}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"
                                           Margin="2,8,2,1" />

                                    <!-- Autor -->
                                    <Label Grid.Row="2"
                                           Text="{Binding Author}"
                                           FontSize="11"
                                           TextColor="{StaticResource Neutral500}"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation"
                                           Margin="2,0,2,0" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- Translation progress bar -->
        <Border Grid.ColumnSpan="2"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="{StaticResource ColorSurface}"
                Padding="16,12"
                IsVisible="{Binding IsTranslatingBook}"
                ZIndex="2">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-2" Radius="6" Opacity="0.15" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                <Label Grid.Row="0" Grid.Column="0"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="{StaticResource ColorText}">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Traduzindo: " />
                            <Span Text="{Binding TranslatingBookTitle}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Button Grid.Row="0" Grid.Column="1"
                        Text="Pausar"
                        Command="{Binding PauseBookTranslationCommand}"
                        BackgroundColor="#E53E3E"
                        TextColor="White"
                        CornerRadius="6"
                        Padding="10,4"
                        FontSize="11"
                        MinimumHeightRequest="32" />
                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                             Progress="{Binding BookTranslationProgress}"
                             ProgressColor="{StaticResource ColorAccent}" />
            </Grid>
        </Border>

        <!-- Model download/loading overlay -->
        <Border Grid.ColumnSpan="2"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="{StaticResource ColorSurface}"
                Padding="16,12"
                IsVisible="{Binding IsModelDownloading}"
                ZIndex="2">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <Label Grid.Row="0" Text="Baixando modelo de tradução..."
                       FontSize="13"
                       TextColor="{StaticResource ColorText}" />
                <ProgressBar Grid.Row="1"
                             Progress="{Binding ModelDownloadProgress}"
                             ProgressColor="{StaticResource ColorAccent}" />
            </Grid>
        </Border>

        <Border Grid.ColumnSpan="2"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                BackgroundColor="{StaticResource ColorSurface}"
                Padding="16,12"
                IsVisible="{Binding IsModelLoading}"
                ZIndex="2">
            <VerticalStackLayout Spacing="6">
                <Label Text="Carregando modelo..."
                       FontSize="13"
                       TextColor="{StaticResource ColorText}" />
                <ActivityIndicator IsRunning="True" HeightRequest="20" Color="{StaticResource ColorAccent}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
