<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TranslateReader.Pages.Controls.SettingsOverlay">

    <Grid>
        <!-- Fundo semi-transparente clicável para fechar -->
        <BoxView x:Name="Backdrop" Color="Black" Opacity="0.4">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Painel de configurações: Desktop = painel lateral direito ancorado (altura cheia,
             desliza da direita); default/mobile = bottom sheet (arrasta de baixo). Layout de
             conteudo abaixo e IDENTICO nos dois idioms - so as propriedades do Border variam. -->
        <Border x:Name="PanelBorder"
                HorizontalOptions="{OnIdiom Default=Fill, Desktop=End}"
                VerticalOptions="{OnIdiom Default=End, Desktop=Fill}"
                WidthRequest="{OnIdiom Default=-1, Desktop=380}"
                BackgroundColor="{StaticResource ColorSurface}"
                Stroke="{StaticResource Neutral800}"
                StrokeThickness="1"
                Shadow="{StaticResource ShadowLg}"
                Padding="0"
                Margin="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="{OnIdiom Default='18,18,0,0', Desktop='0'}" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,Auto,*">

                <!-- Handle de arrasto (mobile bottom sheet apenas) -->
                <BoxView Grid.Row="0"
                         IsVisible="{OnIdiom Default=True, Desktop=False}"
                         WidthRequest="36"
                         HeightRequest="4"
                         CornerRadius="2"
                         Margin="0,10,0,0"
                         HorizontalOptions="Center"
                         Color="{StaticResource Neutral700}" />

                <!-- Header -->
                <Grid Grid.Row="1"
                      Padding="20,18"
                      ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Configurações de leitura"
                           FontSize="17"
                           TextColor="{StaticResource ColorText}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="&#xE4F6;"
                            FontFamily="Phosphor"
                            Clicked="OnCloseClicked"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource ColorText}"
                            FontSize="17"
                            Padding="0"
                            WidthRequest="36"
                            HeightRequest="36"
                            MinimumWidthRequest="36"
                            MinimumHeightRequest="36"
                            CornerRadius="8" />
                </Grid>

                <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="22" Padding="20,4,20,28">

                <!-- Seletor de Tema -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tema"
                           FontSize="13"
                           FontFamily="InterMedium"
                           TextTransform="Uppercase"
                           CharacterSpacing="1"
                           TextColor="{StaticResource Neutral600}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button x:Name="LightThemeButton"
                                Grid.Column="0"
                                Text="Aa&#10;Claro"
                                Clicked="OnLightThemeClicked"
                                BackgroundColor="{StaticResource ReadingLightBg}"
                                TextColor="{StaticResource ReadingLightText}"
                                BorderColor="{StaticResource ColorAccent}"
                                BorderWidth="1"
                                CornerRadius="10"
                                HeightRequest="{OnIdiom Default=59, Desktop=67}"
                                Padding="{OnIdiom Default='6,10', Desktop='8,12'}"
                                HorizontalOptions="Fill"
                                FontSize="12" />
                        <Button x:Name="DarkThemeButton"
                                Grid.Column="1"
                                Text="Aa&#10;Escuro"
                                Clicked="OnDarkThemeClicked"
                                BackgroundColor="{StaticResource ReadingDarkBg}"
                                TextColor="{StaticResource ReadingDarkText}"
                                BorderColor="{StaticResource ColorDivider}"
                                BorderWidth="1"
                                CornerRadius="10"
                                HeightRequest="{OnIdiom Default=59, Desktop=67}"
                                Padding="{OnIdiom Default='6,10', Desktop='8,12'}"
                                HorizontalOptions="Fill"
                                FontSize="12" />
                        <Button x:Name="SepiaThemeButton"
                                Grid.Column="2"
                                Text="Aa&#10;Sépia"
                                Clicked="OnSepiaThemeClicked"
                                BackgroundColor="{StaticResource ReadingSepiaBg}"
                                TextColor="{StaticResource ReadingSepiaText}"
                                BorderColor="{StaticResource ColorDivider}"
                                BorderWidth="1"
                                CornerRadius="10"
                                HeightRequest="{OnIdiom Default=59, Desktop=67}"
                                Padding="{OnIdiom Default='6,10', Desktop='8,12'}"
                                HorizontalOptions="Fill"
                                FontSize="12" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Modo de leitura (segmented; ordem: Paginado primeiro, depois Rolagem) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Modo de leitura"
                           FontSize="13"
                           FontFamily="InterMedium"
                           TextTransform="Uppercase"
                           CharacterSpacing="1"
                           TextColor="{StaticResource Neutral600}" />
                    <Border BackgroundColor="Transparent"
                            Stroke="{StaticResource ColorDivider}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            HeightRequest="35"
                            Padding="0">
                        <Grid ColumnDefinitions="*,*">
                            <Button x:Name="PaginatedModeButton"
                                    Grid.Column="0"
                                    Text="Paginado"
                                    Clicked="OnPaginatedModeClicked"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource ColorAccent}"
                                    FontFamily="InterRegular"
                                    BorderWidth="0"
                                    CornerRadius="0"
                                    ContentLayout="Left,6"
                                    Padding="12,7"
                                    FontSize="13">
                                <Button.ImageSource>
                                    <FontImageSource x:Name="PaginatedModeIcon" FontFamily="Phosphor" Glyph="&#xE0E6;" Size="15" Color="{StaticResource ColorAccent}" />
                                </Button.ImageSource>
                            </Button>
                            <Button x:Name="ScrollModeButton"
                                    Grid.Column="1"
                                    Text="Rolagem"
                                    Clicked="OnScrollModeClicked"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource ColorText}"
                                    FontFamily="InterRegular"
                                    BorderWidth="0"
                                    CornerRadius="0"
                                    ContentLayout="Left,6"
                                    Padding="12,7"
                                    FontSize="13">
                                <Button.ImageSource>
                                    <FontImageSource x:Name="ScrollModeIcon" FontFamily="Phosphor" Glyph="&#xEB04;" Size="15" Color="{StaticResource ColorText}" />
                                </Button.ImageSource>
                            </Button>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Fonte -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Fonte" FontSize="12" TextColor="{StaticResource TextMuted70}" />
                    <Border BackgroundColor="{StaticResource ColorSurface}"
                            Stroke="{StaticResource ColorDivider}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            HeightRequest="36"
                            Padding="10,0">
                        <Picker x:Name="FontPicker"
                                SelectedIndexChanged="OnFontPickerChanged"
                                TextColor="{StaticResource ColorText}"
                                FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Tamanho da fonte -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Tamanho da fonte" FontSize="12" TextColor="{StaticResource TextMuted70}" />
                        <Label Grid.Column="1" x:Name="FontSizeLabel" FontSize="12" TextColor="{StaticResource ColorAccent}" />
                    </Grid>
                    <Slider x:Name="FontSizeSlider"
                            Minimum="12"
                            Maximum="32"
                            MinimumTrackColor="{StaticResource ColorAccent}"
                            MaximumTrackColor="{StaticResource Neutral700}"
                            ThumbColor="{StaticResource ColorAccent}"
                            ValueChanged="OnFontSizeChanged" />
                </VerticalStackLayout>

                <!-- Espaçamento entre linhas -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Espaçamento de linhas" FontSize="12" TextColor="{StaticResource TextMuted70}" />
                        <Label Grid.Column="1" x:Name="LineSpacingLabel" FontSize="12" TextColor="{StaticResource ColorAccent}" />
                    </Grid>
                    <Slider x:Name="LineSpacingSlider"
                            Minimum="1.0"
                            Maximum="3.0"
                            MinimumTrackColor="{StaticResource ColorAccent}"
                            MaximumTrackColor="{StaticResource Neutral700}"
                            ThumbColor="{StaticResource ColorAccent}"
                            ValueChanged="OnLineSpacingChanged" />
                </VerticalStackLayout>

                <!-- Espaçamento entre letras -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Espaçamento de letras" FontSize="12" TextColor="{StaticResource TextMuted70}" />
                        <Label Grid.Column="1" x:Name="LetterSpacingLabel" FontSize="12" TextColor="{StaticResource ColorAccent}" />
                    </Grid>
                    <Slider x:Name="LetterSpacingSlider"
                            Minimum="-1"
                            Maximum="3"
                            MinimumTrackColor="{StaticResource ColorAccent}"
                            MaximumTrackColor="{StaticResource Neutral700}"
                            ThumbColor="{StaticResource ColorAccent}"
                            ValueChanged="OnLetterSpacingChanged" />
                </VerticalStackLayout>

                <!-- Espaçamento entre palavras -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Espaçamento de palavras" FontSize="12" TextColor="{StaticResource TextMuted70}" />
                        <Label Grid.Column="1" x:Name="WordSpacingLabel" FontSize="12" TextColor="{StaticResource ColorAccent}" />
                    </Grid>
                    <Slider x:Name="WordSpacingSlider"
                            Minimum="0"
                            Maximum="10"
                            MinimumTrackColor="{StaticResource ColorAccent}"
                            MaximumTrackColor="{StaticResource Neutral700}"
                            ThumbColor="{StaticResource ColorAccent}"
                            ValueChanged="OnWordSpacingChanged" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1"
                         Color="{StaticResource ColorDivider}" />

                <!-- Tradução -->
                <Label Text="Traducao"
                       FontSize="13"
                       FontFamily="InterMedium"
                       TextTransform="Uppercase"
                       CharacterSpacing="1"
                       TextColor="{StaticResource Neutral600}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Idioma de origem" FontSize="12" TextColor="{StaticResource TextMuted70}" />
                        <Border BackgroundColor="{StaticResource ColorSurface}"
                                Stroke="{StaticResource ColorDivider}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                HeightRequest="36"
                                Padding="10,0">
                            <Picker x:Name="SourceLanguagePicker"
                                    SelectedIndexChanged="OnSourceLanguageChanged"
                                    TextColor="{StaticResource ColorText}"
                                    FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Idioma de destino" FontSize="12" TextColor="{StaticResource TextMuted70}" />
                        <Border BackgroundColor="{StaticResource ColorSurface}"
                                Stroke="{StaticResource ColorDivider}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                HeightRequest="36"
                                Padding="10,0">
                            <Picker x:Name="TargetLanguagePicker"
                                    SelectedIndexChanged="OnTargetLanguageChanged"
                                    TextColor="{StaticResource ColorText}"
                                    FontSize="14" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Modelo local: lista vertical (era ScrollView horizontal de pills) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Modelo local"
                           FontSize="13"
                           FontFamily="InterMedium"
                           TextTransform="Uppercase"
                           CharacterSpacing="1"
                           TextColor="{StaticResource Neutral600}" />
                    <VerticalStackLayout x:Name="ModelsList" Spacing="8">
                        <Border x:Name="GemmaModelButton"
                                HeightRequest="53"
                                BackgroundColor="Transparent"
                                Stroke="{StaticResource Neutral800}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGemmaClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label x:Name="GemmaModelRadioIcon"
                                       Grid.Column="0"
                                       FontFamily="Phosphor"
                                       Text="&#xE18A;"
                                       FontSize="16"
                                       TextColor="{StaticResource Neutral500}"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Gemma 2B" FontSize="13" TextColor="{StaticResource ColorText}" />
                                    <Label Text="gemma-2-2b-it-Q4_K_M.gguf" FontSize="11" TextColor="{StaticResource Neutral500}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="1.5 GB" FontSize="11" TextColor="{StaticResource Neutral600}" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Qwen/Phi: apenas placeholders de UI hoje (TranslationManager.ResolveModel
                             nao tem entrada no ModelRegistry para eles - ver TranslationManager.cs).
                             Sem filename/tamanho REAIS para mostrar sem inventar dado -
                             BLOCKED registrado no SUMMARY.md desta phase. -->
                        <Border x:Name="QwenModelButton"
                                HeightRequest="53"
                                BackgroundColor="Transparent"
                                Stroke="{StaticResource Neutral800}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnQwenClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label x:Name="QwenModelRadioIcon"
                                       Grid.Column="0"
                                       FontFamily="Phosphor"
                                       Text="&#xE18A;"
                                       FontSize="16"
                                       TextColor="{StaticResource Neutral500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Qwen 3B" FontSize="13" TextColor="{StaticResource ColorText}" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="PhiModelButton"
                                HeightRequest="53"
                                BackgroundColor="Transparent"
                                Stroke="{StaticResource Neutral800}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPhiClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label x:Name="PhiModelRadioIcon"
                                       Grid.Column="0"
                                       FontFamily="Phosphor"
                                       Text="&#xE18A;"
                                       FontSize="16"
                                       TextColor="{StaticResource Neutral500}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Phi 3.5" FontSize="13" TextColor="{StaticResource ColorText}" VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border x:Name="HyMtModelButton"
                                HeightRequest="53"
                                BackgroundColor="Transparent"
                                Stroke="{StaticResource Neutral800}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHyMtClicked" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label x:Name="HyMtModelRadioIcon"
                                       Grid.Column="0"
                                       FontFamily="Phosphor"
                                       Text="&#xE18A;"
                                       FontSize="16"
                                       TextColor="{StaticResource Neutral500}"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="HY-MT 1.8B" FontSize="13" TextColor="{StaticResource ColorText}" />
                                    <Label Text="HY-MT1.5-1.8B-Q4_K_M.gguf" FontSize="11" TextColor="{StaticResource Neutral500}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="1.1 GB" FontSize="11" TextColor="{StaticResource Neutral600}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                    <Label Text="Powered by Tencent HY. Nao afiliado a Tencent. Detalhes em THIRD-PARTY-NOTICES.md."
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{StaticResource Neutral500}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="8">
                    <Label FontFamily="Phosphor"
                           Text="&#xE602;"
                           FontSize="14"
                           TextColor="{StaticResource Neutral600}"
                           VerticalOptions="Center" />
                    <Label x:Name="ModelStatusLabel"
                           Text="Modelo nao baixado"
                           FontSize="12"
                           TextColor="{StaticResource Neutral600}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button x:Name="DeleteModelButton"
                        Text="Excluir modelo"
                        Clicked="OnDeleteModelClicked"
                        BackgroundColor="{StaticResource ColorDanger}"
                        TextColor="{StaticResource ColorBg}"
                        CornerRadius="8"
                        MinimumHeightRequest="44"
                        Padding="12,6"
                        FontSize="12"
                        IsVisible="False"
                        HorizontalOptions="Start" />

                </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</ContentView>
