<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TranslateReader.Pages.Controls.SettingsOverlay">

    <Grid>
        <!-- Fundo semi-transparente clicável para fechar -->
        <BoxView x:Name="Backdrop" Color="Black" Opacity="0.4">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackdropTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Painel de configurações: Desktop = painel lateral direito ancorado (altura cheia,
             desliza da direita); default/mobile = bottom sheet (arrasta de baixo). Layout de
             conteudo abaixo e IDENTICO nos dois idioms - so as propriedades do Border variam. -->
        <Border x:Name="PanelBorder"
                HorizontalOptions="{OnIdiom Default=Fill, Desktop=End}"
                VerticalOptions="{OnIdiom Default=End, Desktop=Fill}"
                WidthRequest="{OnIdiom Default=-1, Desktop=400}"
                BackgroundColor="{StaticResource ColorSurface}"
                Stroke="{StaticResource Neutral800}"
                StrokeThickness="1"
                Shadow="{StaticResource ShadowLg}"
                Padding="{OnIdiom Default='20,16,20,32', Desktop='28,24'}"
                Margin="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="{OnIdiom Default='16,16,0,0', Desktop='0'}" />
            </Border.StrokeShape>

            <ScrollView>
            <VerticalStackLayout Spacing="16">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Text="Configurações de leitura"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource ColorText}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="✕"
                            Clicked="OnCloseClicked"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource ColorText}"
                            FontSize="18"
                            Padding="8,0"
                            HeightRequest="36" />
                </Grid>

                <BoxView HeightRequest="1"
                         Color="{StaticResource ColorDivider}" />

                <!-- Seletor de Tema -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tema"
                           FontSize="12"
                           TextTransform="Uppercase"
                           CharacterSpacing="1"
                           TextColor="{StaticResource Neutral400}" />
                    <HorizontalStackLayout Spacing="12">
                        <Button x:Name="LightThemeButton"
                                Text="☀ Claro"
                                Clicked="OnLightThemeClicked"
                                BackgroundColor="#FFFFFF"
                                TextColor="#1A1A1A"
                                BorderColor="{StaticResource ColorAccent}"
                                BorderWidth="2"
                                CornerRadius="20"
                                Padding="12,6"
                                FontSize="12" />
                        <Button x:Name="DarkThemeButton"
                                Text="☾ Escuro"
                                Clicked="OnDarkThemeClicked"
                                BackgroundColor="{StaticResource ColorSurface}"
                                TextColor="{StaticResource ColorText}"
                                BorderColor="{StaticResource ColorSurface}"
                                BorderWidth="2"
                                CornerRadius="20"
                                Padding="12,6"
                                FontSize="12" />
                        <Button x:Name="SepiaThemeButton"
                                Text="☕ Sépia"
                                Clicked="OnSepiaThemeClicked"
                                BackgroundColor="#F4ECD8"
                                TextColor="#5B4636"
                                BorderColor="#F4ECD8"
                                BorderWidth="2"
                                CornerRadius="20"
                                Padding="12,6"
                                FontSize="12" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Modo de leitura -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Modo de leitura"
                           FontSize="12"
                           TextTransform="Uppercase"
                           CharacterSpacing="1"
                           TextColor="{StaticResource Neutral400}" />
                    <HorizontalStackLayout Spacing="12">
                        <Button x:Name="ScrollModeButton"
                                Text="Rolagem"
                                Clicked="OnScrollModeClicked"
                                BackgroundColor="{StaticResource Neutral800}"
                                TextColor="{StaticResource ColorText}"
                                BorderColor="{StaticResource ColorAccent}"
                                BorderWidth="2"
                                CornerRadius="20"
                                Padding="12,6"
                                FontSize="12" />
                        <Button x:Name="PaginatedModeButton"
                                Text="Paginado"
                                Clicked="OnPaginatedModeClicked"
                                BackgroundColor="{StaticResource Neutral800}"
                                TextColor="{StaticResource ColorText}"
                                BorderColor="Transparent"
                                BorderWidth="2"
                                CornerRadius="20"
                                Padding="12,6"
                                FontSize="12" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Fonte -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Fonte" FontSize="14" />
                    <Picker x:Name="FontPicker"
                            SelectedIndexChanged="OnFontPickerChanged"
                            FontSize="14" />
                </VerticalStackLayout>

                <!-- Tamanho da fonte -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Tamanho da fonte" FontSize="14" />
                        <Label Grid.Column="1" x:Name="FontSizeLabel" FontSize="14" />
                    </Grid>
                    <Slider x:Name="FontSizeSlider"
                            Minimum="12"
                            Maximum="32"
                            MinimumTrackColor="{StaticResource ColorAccent}"
                            MaximumTrackColor="{StaticResource Neutral700}"
                            ThumbColor="{StaticResource ColorAccent}"
                            ValueChanged="OnFontSizeChanged" />
                </VerticalStackLayout>

                <!-- Espaçamento entre linhas -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Espaçamento de linhas" FontSize="14" />
                        <Label Grid.Column="1" x:Name="LineSpacingLabel" FontSize="14" />
                    </Grid>
                    <Slider x:Name="LineSpacingSlider"
                            Minimum="1.0"
                            Maximum="3.0"
                            MinimumTrackColor="{StaticResource ColorAccent}"
                            MaximumTrackColor="{StaticResource Neutral700}"
                            ThumbColor="{StaticResource ColorAccent}"
                            ValueChanged="OnLineSpacingChanged" />
                </VerticalStackLayout>

                <!-- Espaçamento entre letras -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Espaçamento de letras" FontSize="14" />
                        <Label Grid.Column="1" x:Name="LetterSpacingLabel" FontSize="14" />
                    </Grid>
                    <Slider x:Name="LetterSpacingSlider"
                            Minimum="-1"
                            Maximum="3"
                            MinimumTrackColor="{StaticResource ColorAccent}"
                            MaximumTrackColor="{StaticResource Neutral700}"
                            ThumbColor="{StaticResource ColorAccent}"
                            ValueChanged="OnLetterSpacingChanged" />
                </VerticalStackLayout>

                <!-- Espaçamento entre palavras -->
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Espaçamento de palavras" FontSize="14" />
                        <Label Grid.Column="1" x:Name="WordSpacingLabel" FontSize="14" />
                    </Grid>
                    <Slider x:Name="WordSpacingSlider"
                            Minimum="0"
                            Maximum="10"
                            MinimumTrackColor="{StaticResource ColorAccent}"
                            MaximumTrackColor="{StaticResource Neutral700}"
                            ThumbColor="{StaticResource ColorAccent}"
                            ValueChanged="OnWordSpacingChanged" />
                </VerticalStackLayout>

                <BoxView HeightRequest="1"
                         Color="{StaticResource ColorDivider}" />

                <!-- Tradução -->
                <Label Text="Traducao"
                       FontSize="12"
                       TextTransform="Uppercase"
                       CharacterSpacing="1"
                       TextColor="{StaticResource Neutral400}" />

                <!-- Idioma de origem -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Idioma de origem" FontSize="14" />
                    <Picker x:Name="SourceLanguagePicker"
                            SelectedIndexChanged="OnSourceLanguageChanged"
                            FontSize="14" />
                </VerticalStackLayout>

                <!-- Idioma de destino -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Idioma de destino" FontSize="14" />
                    <Picker x:Name="TargetLanguagePicker"
                            SelectedIndexChanged="OnTargetLanguageChanged"
                            FontSize="14" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Modelo" FontSize="14" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="12">
                            <Button x:Name="GemmaModelButton"
                                    Text="Gemma 2B"
                                    Clicked="OnGemmaClicked"
                                    BackgroundColor="{StaticResource Neutral800}"
                                    TextColor="{StaticResource ColorText}"
                                    BorderColor="{StaticResource ColorAccent}"
                                    BorderWidth="2"
                                    CornerRadius="20"
                                    Padding="12,6"
                                    FontSize="12" />
                            <Button x:Name="QwenModelButton"
                                    Text="Qwen 3B"
                                    Clicked="OnQwenClicked"
                                    BackgroundColor="{StaticResource Neutral800}"
                                    TextColor="{StaticResource ColorText}"
                                    BorderColor="Transparent"
                                    BorderWidth="2"
                                    CornerRadius="20"
                                    Padding="12,6"
                                    FontSize="12" />
                            <Button x:Name="PhiModelButton"
                                    Text="Phi 3.5"
                                    Clicked="OnPhiClicked"
                                    BackgroundColor="{StaticResource Neutral800}"
                                    TextColor="{StaticResource ColorText}"
                                    BorderColor="Transparent"
                                    BorderWidth="2"
                                    CornerRadius="20"
                                    Padding="12,6"
                                    FontSize="12" />
                            <Button x:Name="HyMtModelButton"
                                    Text="HY-MT 1.8B"
                                    Clicked="OnHyMtClicked"
                                    BackgroundColor="{StaticResource Neutral800}"
                                    TextColor="{StaticResource ColorText}"
                                    BorderColor="Transparent"
                                    BorderWidth="2"
                                    CornerRadius="20"
                                    Padding="12,6"
                                    FontSize="12" />
                        </HorizontalStackLayout>
                    </ScrollView>
                    <Label Text="Powered by Tencent HY. Nao afiliado a Tencent. Detalhes em THIRD-PARTY-NOTICES.md."
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{StaticResource Neutral500}" />
                </VerticalStackLayout>

                <Label x:Name="ModelStatusLabel"
                       Text="Modelo nao baixado"
                       FontSize="12"
                       TextColor="{StaticResource Neutral500}" />

                <Button x:Name="DeleteModelButton"
                        Text="Excluir modelo"
                        Clicked="OnDeleteModelClicked"
                        BackgroundColor="#E53E3E"
                        TextColor="White"
                        CornerRadius="8"
                        MinimumHeightRequest="44"
                        Padding="12,6"
                        FontSize="12"
                        IsVisible="False"
                        HorizontalOptions="Start" />

            </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentView>
