<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TranslateReader.Pages.Controls.TranslateBookPopup">

    <Border BackgroundColor="{StaticResource ColorSurface}"
            Stroke="{StaticResource Neutral500}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 14"
            Shadow="{StaticResource ShadowLg}"
            Padding="24"
            WidthRequest="340">

        <VerticalStackLayout Spacing="16">
            <Label Text="Traduzir livro"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="{StaticResource ColorText}" />

            <!-- Capa/icone do livro + titulo, autor e numero de capitulos -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        WidthRequest="40"
                        HeightRequest="56"
                        Padding="0"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 4">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource ColorSection}" Offset="0.0" />
                            <GradientStop Color="{StaticResource ColorSectionGlow}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Label x:Name="BookMetaLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap" />
            </Grid>

            <BoxView HeightRequest="1"
                     Color="{StaticResource ColorDivider}" />

            <!-- Aviso: a traducao roda 100% offline (D-...-9 / mockup) -->
            <Border x:Name="OfflineBanner"
                    BackgroundColor="{StaticResource Accent900}"
                    Stroke="{StaticResource Accent700}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="&#8505;"
                           FontSize="14"
                           VerticalOptions="Start"
                           TextColor="{StaticResource Accent200}" />
                    <Label Grid.Column="1"
                           Text="A tradução roda 100% offline com o modelo local. Nenhum texto sai do seu dispositivo."
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{StaticResource Accent200}" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="Idioma de origem"
                       FontSize="13"
                       TextColor="{StaticResource ColorText}" />
                <Label Grid.Row="0" Grid.Column="2"
                       Text="Idioma de destino"
                       FontSize="13"
                       TextColor="{StaticResource ColorText}" />

                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="Transparent"
                        Stroke="{StaticResource Neutral800}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="8,0">
                    <Picker x:Name="SourcePicker"
                            FontSize="14"
                            TextColor="{StaticResource ColorText}"
                            TitleColor="{StaticResource ColorText}" />
                </Border>

                <Label Grid.Row="1" Grid.Column="1"
                       Text="&#8594;"
                       FontSize="16"
                       VerticalOptions="Center"
                       TextColor="{StaticResource ColorAccent}" />

                <Border Grid.Row="1" Grid.Column="2"
                        BackgroundColor="Transparent"
                        Stroke="{StaticResource Neutral800}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="8,0">
                    <Picker x:Name="TargetPicker"
                            FontSize="14"
                            TextColor="{StaticResource ColorText}"
                            TitleColor="{StaticResource ColorText}" />
                </Border>
            </Grid>

            <HorizontalStackLayout Spacing="12" HorizontalOptions="End" Margin="0,8,0,0">
                <Button Text="Cancelar"
                        Clicked="OnCancelClicked"
                        BackgroundColor="{StaticResource Neutral800}"
                        TextColor="{StaticResource ColorText}"
                        CornerRadius="8"
                        Padding="16,8"
                        FontSize="14" />
                <Button Text="Traduzir"
                        Clicked="OnTranslateClicked"
                        BackgroundColor="{StaticResource ColorAccent}"
                        TextColor="{StaticResource Neutral100}"
                        CornerRadius="8"
                        Padding="16,8"
                        FontSize="14" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
