<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TranslateReader.Pages.Controls.TranslateBookPopup">

    <Border BackgroundColor="{StaticResource ColorSurface}"
            Stroke="{StaticResource Neutral500}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 14"
            Shadow="{StaticResource ShadowLg}"
            Padding="12"
            WidthRequest="440">

        <VerticalStackLayout Spacing="10">
            <Label Text="Traduzir livro"
                   FontSize="20"
                   FontFamily="InterMedium"
                   TextColor="{StaticResource ColorText}" />

            <!-- Capa/icone do livro + titulo, autor e numero de capitulos -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0"
                        WidthRequest="34"
                        HeightRequest="51"
                        Padding="0"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource ColorSection}" Offset="0.0" />
                            <GradientStop Color="{StaticResource ColorSectionGlow}" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <BoxView WidthRequest="2"
                             HorizontalOptions="Start"
                             BackgroundColor="{StaticResource ColorAccent}"
                             Opacity="0.5" />
                </Border>

                <Label x:Name="BookMetaLabel"
                       Grid.Column="1"
                       VerticalOptions="Center"
                       LineBreakMode="WordWrap" />
            </Grid>

            <BoxView HeightRequest="1"
                     Color="{StaticResource ColorDivider}" />

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="Idioma de origem"
                       FontSize="12"
                       TextColor="{StaticResource TextMuted70}" />
                <Label Grid.Row="0" Grid.Column="2"
                       Text="Idioma de destino"
                       FontSize="12"
                       TextColor="{StaticResource TextMuted70}" />

                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="Transparent"
                        Stroke="{StaticResource Neutral800}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="8,0">
                    <Picker x:Name="SourcePicker"
                            FontSize="14"
                            TextColor="{StaticResource ColorText}"
                            TitleColor="{StaticResource ColorText}" />
                </Border>

                <Label Grid.Row="1" Grid.Column="1"
                       FontFamily="Phosphor"
                       Text="&#xE06C;"
                       FontSize="15"
                       VerticalOptions="Center"
                       TextColor="{StaticResource ColorAccent}" />

                <Border Grid.Row="1" Grid.Column="2"
                        BackgroundColor="Transparent"
                        Stroke="{StaticResource Neutral800}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="8,0">
                    <Picker x:Name="TargetPicker"
                            FontSize="14"
                            TextColor="{StaticResource ColorText}"
                            TitleColor="{StaticResource ColorText}" />
                </Border>
            </Grid>

            <!-- Aviso: a traducao roda 100% offline (D-...-9 / mockup). Vem DEPOIS dos pickers
                 no mockup (estava antes) - PIXEL-SPEC "modal Traduzir livro". -->
            <Border x:Name="OfflineBanner"
                    BackgroundColor="{StaticResource ColorBg}"
                    Stroke="{StaticResource ColorDivider}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12,10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           FontFamily="Phosphor"
                           Text="&#xE40C;"
                           FontSize="15"
                           VerticalOptions="Start"
                           TextColor="{StaticResource Neutral500}" />
                    <Label Grid.Column="1"
                           Text="A tradução roda 100% offline com o modelo local. Nenhum texto sai do seu dispositivo."
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{StaticResource Neutral500}" />
                </Grid>
            </Border>

            <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,8,0,0">
                <Border Stroke="{StaticResource ColorDivider}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent"
                        HeightRequest="34"
                        Padding="10,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelClicked" />
                    </Border.GestureRecognizers>
                    <Label Text="Cancelar"
                           FontSize="14"
                           FontFamily="InterMedium"
                           TextColor="{StaticResource ColorText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <Border Stroke="{StaticResource ColorAccent}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="Transparent"
                        HeightRequest="34"
                        Padding="10,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTranslateClicked" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label FontFamily="Phosphor"
                               Text="&#xE4A2;"
                               FontSize="15"
                               VerticalOptions="Center"
                               TextColor="{StaticResource ColorAccent}" />
                        <Label Text="Traduzir"
                               FontSize="14"
                               FontFamily="InterMedium"
                               TextColor="{StaticResource ColorAccent}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
