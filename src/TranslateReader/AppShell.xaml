<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TranslateReader.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:TranslateReader.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource ColorBg}"
    Shell.ForegroundColor="{StaticResource ColorText}"
    Shell.TitleColor="{StaticResource ColorText}"
    Shell.DisabledColor="{StaticResource Neutral700}"
    Shell.UnselectedColor="{StaticResource Neutral500}"
    Title="TranslateReader">

    <ShellContent
        Title="Biblioteca"
        ContentTemplate="{DataTemplate pages:LibraryPage}"
        Route="library" />

</Shell>
