<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) AND (Exists('$(LocalAppData)\Android\Sdk') OR Exists('$(ANDROID_HOME)') OR Exists('$(ANDROID_SDK_ROOT)'))">$(TargetFrameworks);net10.0-android</TargetFrameworks>

        <!-- Note for MacCatalyst:
        The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
        When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
        The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
        either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>TranslateReader</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>
        <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

        <!-- Display name -->
        <ApplicationTitle>TranslateReader</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.translatereader</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <!-- 16.4, not the platform-template default of 15.0: llama.cpp's official XCFramework
             release is built with IOS_MIN_OS_VERSION=16.4 (D-2026-08-16-llm-mobile-6). The app is
             not published anywhere yet, so this costs zero real users; it is not compiling a
             lower-minimum build of our own, which would trade a verifiable pinned artifact for a
             self-built one (contrary to D-2026-08-16-llm-mobile-9). MacCatalyst is untouched: it
             gets no backend this phase (D-2026-08-16-llm-mobile-7), so raising its minimum would
             only cut users without shipping anything in return. -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.4</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <!-- 23.0, not the platform-template default of 21.0: the official Android CPU inference
             backend package below ships a .so linked against ANDROID_PLATFORM=android-23 in its
             own CI (D-2026-08-16-llm-mobile-4). Declaring support for API 21/22 while shipping a
             23-linked .so would fail dlopen at runtime with no build-time signal. -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#17171a"/>

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#17171a" BaseSize="128,128"/>

        <!-- Images -->
        <MauiImage Include="Resources\Images\*"/>
        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*"/>

        <!-- Raw Assets -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10"/>
        <!-- CommunityToolkit.Maui 14.2.2 requires WindowsAppSDK >= 2.2.0 (NU1605 downgrade
             otherwise). Bumped alongside the CommunityToolkit.Maui update in this PR. -->
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="CommunityToolkit.Maui" Version="15.0.0"/>
    </ItemGroup>

    <!-- LLamaSharp.Backend.* must track the same version as LLamaSharp (Core csproj) — the
         native llama.cpp ABI is version-locked to the managed loader. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" />
        <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    </ItemGroup>

    <!-- Official Android CPU backend (D-2026-08-16-llm-mobile-4). No CUDA/Vulkan equivalent exists
         for Android today, so unlike Windows there is only one package here; still must track the
         same LLamaSharp version as the Core csproj and the Windows backends above. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="LLamaSharp.Backend.Cpu.Android" Version="0.27.0" />
    </ItemGroup>

    <!-- The package above ships its native .so files via the packaging pattern .NET for Android's
         newer SDK flags (XA0101: it predates the AndroidNativeLibrary build action) and, upstream,
         those .so files are not yet 16 KB page size aligned (XA0141): both are facts about a
         third-party binary we do not control (D-2026-08-16-llm-mobile-4: "measure and record the
         truth, not a threshold we do not control"). The 16 KB alignment is measured, not hidden:
         scripts/check-android-so.sh records every .so's real alignment in docs/NATIVE-BACKENDS.md,
         which is the tracked source of truth, not this build log line. -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);XA0101;XA0141</MSBuildWarningsAsMessages>
    </PropertyGroup>

    <!-- GHSA-2m69-gcr7-jv3q: bundle_green 2.1.11 pulls the vulnerable 2.1.11 native libs on
         mobile TFMs. Same nearest-wins override as the Core csproj, per-platform twins.
         Drop when a fixed bundle_green ships. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.12" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.ios" Version="2.1.12" />
    </ItemGroup>

    <!-- iOS translation backend (D-2026-08-16-llm-mobile-5, D-2026-08-16-llm-mobile-9): LLamaSharp
         cannot run on iOS (its native loader throws PlatformNotSupportedException from its own type
         initializer there), so iOS links llama.cpp's own official XCFramework release directly.
         Pinned by tag + SHA-256, both literal, never `latest`/a branch name; bumping either
         requires re-verifying the P/Invoke surface in Platforms/iOS/LlamaNativeAccess.cs against
         the new release's llama.h. The XCFramework itself is never committed (.gitignore); it is
         fetched (or read from a local cache) by scripts/fetch-llama-xcframework.sh, which verifies
         the SHA-256 before ever extracting anything. -->
    <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <LlamaCppRelease>b10453</LlamaCppRelease>
        <LlamaCppXcframeworkSha256>c47fb6013e886307a7a0a993a1e6c02ce9a46ba0ef5be01f3eb086a13a61ea6a</LlamaCppXcframeworkSha256>
        <LlamaXcframeworkCacheDir>$(MSBuildThisFileDirectory)../../.cache/llama-xcframework/$(LlamaCppRelease)/</LlamaXcframeworkCacheDir>
        <LlamaIosFrameworkPath>$(LlamaXcframeworkCacheDir)llama.framework</LlamaIosFrameworkPath>
        <!-- SYSLIB1062: the source-generated array marshalling in Platforms/iOS/LlamaNativeAccess.cs
             (LibraryImport + MarshalUsing over int[]) compiles to pointer-pinning code that requires
             this. Scoped to iOS only: Windows/Android carry no unsafe code and stay as they are. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Runs before compilation so the framework is guaranteed present the first time anything
         needs it; a no-op on every other TFM (the target itself is iOS-conditioned, so Windows and
         Android builds never invoke this script at all). The <Error> guard turns a silent glob-match-zero
         failure (the exact xamarin/xamarin-macios#19883 failure mode D-2026-08-16-llm-mobile-9 exists
         to avoid) into a build break instead of a green build that ships nothing native. -->
    <Target Name="FetchLlamaXcframework"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'"
            BeforeTargets="CoreCompile">
        <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../../scripts/fetch-llama-xcframework.sh&quot; $(LlamaCppRelease) $(LlamaCppXcframeworkSha256)" />
        <Error Condition="!Exists('$(LlamaIosFrameworkPath)')"
               Text="llama.cpp XCFramework missing after fetch-llama-xcframework.sh ran: $(LlamaIosFrameworkPath) does not exist. Check network access and the pinned LlamaCppRelease/LlamaCppXcframeworkSha256 values." />
    </Target>

    <!-- Kind="Static" + ForceLoad + IsCxx: this XCFramework's slices are static libraries wrapped
         in a .framework bundle (BUILD_SHARED_LIBS=OFF upstream), which xamarin-macios cannot embed
         as a normal dynamic framework. SmartLink="False" because its dead-strip heuristics do not
         handle a static C++ library like this correctly. Frameworks lists exactly what the
         XCFramework's own modulemap declares (c++/Accelerate/Metal/Foundation). Path is a literal,
         never a glob: a glob that matches zero files is a build that silently ships nothing. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <NativeReference Include="$(LlamaIosFrameworkPath)"
                          Kind="Static"
                          ForceLoad="True"
                          IsCxx="True"
                          SmartLink="False"
                          Frameworks="Accelerate Metal Foundation" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TranslateReader.Core\TranslateReader.Core.csproj"/>
    </ItemGroup>

</Project>
