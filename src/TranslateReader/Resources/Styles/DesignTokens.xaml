<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Design tokens extracted from design/DESIGN-REFERENCE.md (mockup :root custom properties).
         App chrome is DARK-ONLY (D-...-3, UserAppTheme = AppTheme.Dark) - there is no Light variant
         of these tokens. The reading theme (Light/Dark/Sepia, generated by ThemeEngine for the
         WebView content) is a separate concern and is NOT affected by this dictionary. -->

    <!-- Base tokens -->
    <Color x:Key="ColorBg">#161826</Color>
    <Color x:Key="ColorSurface">#232532</Color>
    <Color x:Key="ColorText">#E9E9ED</Color>
    <Color x:Key="ColorAccent">#9184D9</Color>
    <Color x:Key="ColorAccent2">#A7A1DB</Color>
    <Color x:Key="ColorDivider">#29E9E9ED</Color>

    <SolidColorBrush x:Key="ColorBgBrush" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="ColorSurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="ColorTextBrush" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="ColorAccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="ColorAccent2Brush" Color="{StaticResource ColorAccent2}" />

    <!-- Section/glow tokens (decorative backgrounds, cover gradients) -->
    <Color x:Key="ColorSection">#262A60</Color>
    <Color x:Key="ColorSectionGlow">#353B80</Color>
    <Color x:Key="ColorSectionGhost">#4C5397</Color>

    <!-- Neutral scale (secondary text, borders, placeholders) -->
    <Color x:Key="Neutral100">#F3F5FE</Color>
    <Color x:Key="Neutral200">#E4E7F5</Color>
    <Color x:Key="Neutral300">#CFD3E5</Color>
    <Color x:Key="Neutral400">#B2B6CA</Color>
    <Color x:Key="Neutral500">#9397AB</Color>
    <Color x:Key="Neutral600">#75798C</Color>
    <Color x:Key="Neutral700">#595D6C</Color>
    <Color x:Key="Neutral800">#3F424D</Color>
    <Color x:Key="Neutral900">#292B31</Color>

    <!-- Accent scale (purple - hover/active/selected states) -->
    <Color x:Key="Accent100">#F5F4FF</Color>
    <Color x:Key="Accent200">#E7E5FE</Color>
    <Color x:Key="Accent300">#D2CEFD</Color>
    <Color x:Key="Accent400">#B5ABFC</Color>
    <Color x:Key="Accent500">#968AE0</Color>
    <Color x:Key="Accent600">#796CBF</Color>
    <Color x:Key="Accent700">#5D5294</Color>
    <Color x:Key="Accent800">#423A6A</Color>
    <Color x:Key="Accent900">#2B2741</Color>

    <!-- Accent-2 scale (greyed-purple, more neutral variant of accent) -->
    <Color x:Key="AccentSecondary100">#F5F4FF</Color>
    <Color x:Key="AccentSecondary200">#E7E5FE</Color>
    <Color x:Key="AccentSecondary300">#D2CEFD</Color>
    <Color x:Key="AccentSecondary400">#B5AFE8</Color>
    <Color x:Key="AccentSecondary500">#9690C9</Color>
    <Color x:Key="AccentSecondary600">#7972A9</Color>
    <Color x:Key="AccentSecondary700">#5C5783</Color>
    <Color x:Key="AccentSecondary800">#423E5D</Color>
    <Color x:Key="AccentSecondary900">#2B293A</Color>

    <!-- Radius -->
    <x:Double x:Key="RadiusSm">4</x:Double>
    <x:Double x:Key="RadiusMd">8</x:Double>
    <x:Double x:Key="RadiusLg">14</x:Double>

    <!-- Shadows: the mockup composes a hairline stroke (Neutral800/700/500) with a drop shadow.
         Sm has no blur - Border.Stroke alone (Neutral800) reproduces it. Md/Lg pair a
         Border.Stroke of the matching Neutral shade with these Shadow objects on Border.Shadow. -->
    <Shadow x:Key="ShadowMd" Brush="Black" Offset="0,6" Radius="18" Opacity="0.55" />
    <Shadow x:Key="ShadowLg" Brush="Black" Offset="0,16" Radius="40" Opacity="0.65" />

    <!-- Reading-theme sample swatches (CONTENT, not chrome): the exact bg/text pairs
         ThemeEngine.ResolveThemeColors returns for each reading theme (Light/Dark/Sepia),
         applied inside the WebView reading pane. SettingsOverlay's theme-picker buttons use
         these so the preview matches what the reader will actually see - the app chrome
         itself stays dark-only (see header note) and these tokens are not chrome colors. -->
    <Color x:Key="ReadingLightBg">#FFFFFF</Color>
    <Color x:Key="ReadingLightText">#1A1A1A</Color>
    <Color x:Key="ReadingDarkBg">#1A1A2E</Color>
    <Color x:Key="ReadingDarkText">#E4E4E7</Color>
    <Color x:Key="ReadingSepiaBg">#F4ECD8</Color>
    <Color x:Key="ReadingSepiaText">#5B4636</Color>

</ResourceDictionary>
